<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/valorae_surface_variant"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/modalTicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:textSize="26sp"
        android:textColor="@color/valorae_text_primary" />

    <TextView
        android:id="@+id/modalName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        android:textColor="@color/valorae_text_secondary"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:baselineAligned="false"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREÇO ATUAL"
                android:textSize="11sp"
                android:textColor="@color/valorae_text_secondary"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/modalCurrentPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/valorae_text_primary"
                android:fontFamily="sans-serif-black"
                android:textSize="20sp" />
             <TextView
                android:id="@+id/modalPriceChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/valorae_text_secondary"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
             <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POSIÇÃO ATUAL"
                android:textSize="11sp"
                android:textColor="@color/valorae_text_secondary"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/modalPositionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/valorae_text_primary"
                android:fontFamily="sans-serif-black"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/modalReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/valorae_positive"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modalMetricsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chip_soft"
        android:padding="16dp"
        android:layout_marginBottom="24dp">
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModalClose"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Fechar"
        android:textColor="@color/valorae_surface"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/valorae_primary" />

</LinearLayout>
